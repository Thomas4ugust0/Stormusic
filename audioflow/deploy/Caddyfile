# TLS automático (Let's Encrypt). DOMAIN vem do .env (ex.: meumusic.duckdns.org).
{$DOMAIN} {
	encode zstd gzip

	# API AudioFlow (mesma origem do frontend → sem CORS)
	@api path /api/* /health /docs* /openapi.json
	handle @api {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	# Frontend PWA (conteúdo de dist/ copiado para deploy/web)
	handle {
		root * /srv/web
		@sw path /sw.js /registerSW.js /manifest.webmanifest /index.html
		header @sw Cache-Control "no-cache"
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
